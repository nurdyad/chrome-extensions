# -----------------------------------------------------------------------------
# MailroomNavigator local automation template
# Copy this file to .env and fill in real values on each machine.
# Do not commit the real .env file.
# -----------------------------------------------------------------------------

# Local linear trigger server (optional)
LINEAR_TRIGGER_SERVER_HOST=127.0.0.1
LINEAR_TRIGGER_SERVER_PORT=4817
# Only needed if LINEAR_TRIGGER_SERVER_HOST above is set to a LAN address so
# other machines can share this server (see SETUP.md 5.2) - the server has
# no other authentication, so set this whenever you do that. Generate with:
# openssl rand -hex 24
# LINEAR_TRIGGER_SHARED_SECRET=
LINEAR_TRIGGER_BOT_JOBS_DIR=
LINEAR_TRIGGER_BOT_JOBS_ENTRY=bot-jobs.js
LINEAR_TRIGGER_BOT_JOBS_ENV_FILE=
# Optional docman-tool launcher used by Navigator practice actions.
# Defaults try ~/tools/docman-tool when not set.
LINEAR_TRIGGER_DOCMAN_TOOL_DIR=
LINEAR_TRIGGER_DOCMAN_TOOL_ENTRY=run.js
LINEAR_TRIGGER_DOCMAN_TOOL_TIMEOUT_MINUTES=45
LINEAR_TRIGGER_ALLOWED_ORIGINS=
LINEAR_TRIGGER_ALLOW_NO_ORIGIN=1

# Optional Cloud SQL read-replica lookup through local Cloud SQL Proxy.
# Start the proxy on 127.0.0.1:15432, then fill the password from Bitwarden.
# Leave MAILROOMNAV_SQL_PASSWORD empty to disable database-backed lookups.
MAILROOMNAV_SQL_ENABLED=1
MAILROOMNAV_SQL_HOST=127.0.0.1
MAILROOMNAV_SQL_PORT=15432
MAILROOMNAV_SQL_DATABASE=mailroom_prod
MAILROOMNAV_SQL_USER=reporting
MAILROOMNAV_SQL_PASSWORD=
MAILROOMNAV_SQL_UUID_LOOKUP_TIMEOUT_MS=20000
# Reconcile Linear uses Cloud SQL first when this is enabled/configured.
# Set to 0 only if you need the legacy BetterLetter dashboard scraping fallback.
MAILROOMNAV_SQL_RECONCILE_ENABLED=1
MAILROOMNAV_SQL_RECONCILE_MAX_ROWS=1000
MAILROOMNAV_SQL_RECONCILE_QUERY_TIMEOUT_MS=15000

# Linear issue creation from extension (required for "Create Linear Issue")
LINEAR_API_KEY=
# Team key (short code shown in issue IDs, e.g. SUPP for SUPP-1762)
LINEAR_TEAM_KEY=SUPP
# Optional fallback when panel priority is "No priority" (0/1/2/3/4)
LINEAR_ISSUE_DEFAULT_PRIORITY=0
# Existing duplicate issues are moved here when the same document/job returns to Require Attention.
LINEAR_DUPLICATE_REOPEN_STATE_NAME=In Review
# Optional Slack sync for Linear issue creation (required only if Slack notify is enabled in panel)
SLACK_BOT_TOKEN=
# Slack sync list scope (1 = only channels bot is already a member of, 0 = list all visible channels)
SLACK_SYNC_MEMBER_ONLY=1
