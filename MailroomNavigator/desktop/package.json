{
  "name": "mailroomnavigator-desktop",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Optional Windows and macOS desktop toolbar for MailroomNavigator",
  "author": "MailroomNavigator contributors",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64",
    "test:native": "electron tests/native-smoke.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.betterletter.mailroomnavigator.desktop",
    "productName": "MailroomNavigator Desktop",
    "files": [
      "src/**",
      "shared/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
